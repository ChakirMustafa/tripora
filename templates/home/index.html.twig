{% extends 'base.html.twig' %}

{% block body_class %}page-home{% endblock %}

{% block body %}

    <section class="hero" id="search">
        <div class="hero__bg" aria-hidden="true">
            <span class="hero__blob hero__blob--1"></span>
            <span class="hero__blob hero__blob--2"></span>
            <span class="hero__blob hero__blob--3"></span>
            <span class="hero__grid"></span>
        </div>

        <div class="container hero__inner">
            <p class="eyebrow">Your next trip starts with one search</p>

            <h1 class="hero__title">
                Search any city.<br>
                <span class="hero__title-accent">Discover everything worth doing.</span>
            </h1>

            <p class="hero__subtitle">
                Tripora instantly curates the best attractions, restaurants, hidden gems, museums,
                cafés, parks and nightlife for any city on earth — then turns it into a ready-made itinerary.
            </p>

            <form class="search-bar" action="{{ path('app_search') }}" method="get" role="search" aria-label="Search a city">
                <svg class="search-bar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <label for="city-input" class="sr-only">City</label>
                <input
                    type="text"
                    id="city-input"
                    name="city"
                    class="search-bar__input"
                    placeholder="Try “Berlin”, “Tokyo”, “Lisbon”…"
                    list="city-suggestions"
                    autocomplete="off"
                    required
                >
                <datalist id="city-suggestions">
                    {% for city in featured_cities %}
                        <option value="{{ city.name }}"></option>
                    {% endfor %}
                    <option value="Rome"></option>
                    <option value="Barcelona"></option>
                    <option value="Amsterdam"></option>
                    <option value="London"></option>
                </datalist>
                <button type="submit" class="btn btn--primary search-bar__submit">
                    Explore
                </button>
            </form>

            <p class="hero__hint">No sign-up needed to browse · Free forever for travelers</p>

            <div class="hero__chips" aria-hidden="true">
                <div class="hero__chip hero__chip--a">
                    <span class="hero__chip-emoji">🏛️</span>
                    <span>482 attractions curated in Berlin</span>
                </div>
                <div class="hero__chip hero__chip--b">
                    <span class="hero__chip-emoji">☕</span>
                    <span>Hidden cafés, mapped street by street</span>
                </div>
                <div class="hero__chip hero__chip--c">
                    <span class="hero__chip-emoji">🌃</span>
                    <span>Nightlife guide, updated weekly</span>
                </div>
            </div>
        </div>
    </section>

    <section class="stats-strip" aria-label="Platform statistics">
        <div class="container stats-strip__row">
            <div class="stat">
                <span class="stat__value">120+</span>
                <span class="stat__label">countries covered</span>
            </div>
            <div class="stat">
                <span class="stat__value">2,400+</span>
                <span class="stat__label">cities mapped</span>
            </div>
            <div class="stat">
                <span class="stat__value">180K+</span>
                <span class="stat__label">places curated</span>
            </div>
            <div class="stat">
                <span class="stat__value">4.9/5</span>
                <span class="stat__label">average traveler rating</span>
            </div>
        </div>
    </section>

    <section class="section" id="what-you-get" {{ stimulus_controller('reveal') }}>
        <div class="container">
            <div class="section-heading">
                <p class="eyebrow">What you'll find</p>
                <h2>Every reason to love a city, in one place</h2>
                <p class="section-heading__lede">
                    Stop juggling ten tabs and outdated blog posts. Tripora curates it all, for any city, instantly.
                </p>
            </div>

            <div class="feature-grid">
                {% set features = [
                    { icon: 'pin', title: 'Attractions', text: 'Landmarks, viewpoints and can’t-miss sights, ranked by what locals and travelers actually love.' },
                    { icon: 'fork', title: 'Restaurants', text: 'From street food to tasting menus — filtered by cuisine, budget and neighborhood.' },
                    { icon: 'spark', title: 'Hidden gems', text: 'The spots that never make the guidebooks, surfaced from real local knowledge.' },
                    { icon: 'columns', title: 'Museums & culture', text: 'Galleries, museums and cultural sites, with the context to make them worth the visit.' },
                    { icon: 'route', title: 'Itineraries', text: 'Ready-made day plans that turn a list of places into an actual day out.' },
                    { icon: 'cup', title: 'Cafés', text: 'The best places to slow down, work, or people-watch over great coffee.' },
                    { icon: 'tree', title: 'Parks & nature', text: 'Green space, waterfronts and quiet escapes inside every city.' },
                    { icon: 'moon', title: 'Nightlife', text: 'Bars, live music and late-night spots that match the vibe you’re after.' },
                ] %}

                {% for feature in features %}
                    <article class="feature-card" data-reveal-target="item">
                        <span class="feature-card__icon">
                            {% include 'partials/_icon.html.twig' with { icon: feature.icon } %}
                        </span>
                        <h3>{{ feature.title }}</h3>
                        <p>{{ feature.text }}</p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section section--muted" id="how-it-works" {{ stimulus_controller('reveal') }}>
        <div class="container">
            <div class="section-heading">
                <p class="eyebrow">How it works</p>
                <h2>From city name to full day out in seconds</h2>
            </div>

            <ol class="steps">
                <li class="step" data-reveal-target="item">
                    <span class="step__number">01</span>
                    <h3>Search any city</h3>
                    <p>Type a city, anywhere in the world. No account, no setup — just start typing.</p>
                </li>
                <li class="step" data-reveal-target="item">
                    <span class="step__number">02</span>
                    <h3>Get curated picks</h3>
                    <p>We surface the best attractions, food, culture and nightlife — organized by category and vibe.</p>
                </li>
                <li class="step" data-reveal-target="item">
                    <span class="step__number">03</span>
                    <h3>Build your itinerary</h3>
                    <p>Save favorites and let Tripora arrange them into a realistic, walkable day-by-day plan.</p>
                </li>
            </ol>
        </div>
    </section>

    <section class="section" id="explore" {{ stimulus_controller('reveal')|stimulus_controller('city-carousel') }}>
        <div class="container">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">Popular right now</p>
                    <h2>Where travelers are exploring today</h2>
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn" aria-label="Scroll left" {{ stimulus_action('city-carousel', 'prev') }}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    <button type="button" class="carousel-btn" aria-label="Scroll right" {{ stimulus_action('city-carousel', 'next') }}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="city-row-wrap container">
            <div class="city-row" {{ stimulus_target('city-carousel', 'track') }}>
                {% for city in featured_cities %}
                    <a href="{{ path('app_search', { city: city.name }) }}" class="city-card city-card--{{ city.accent }}" data-reveal-target="item">
                        <span class="city-card__skyline" aria-hidden="true">
                            {% include 'partials/_skyline.html.twig' %}
                        </span>
                        <span class="city-card__body">
                            <span class="city-card__name">{{ city.name }}</span>
                            <span class="city-card__country">{{ city.country }}</span>
                            <span class="city-card__tagline">{{ city.tagline }}</span>
                            <span class="city-card__meta">{{ city.places }} curated places</span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section quote-section" {{ stimulus_controller('reveal') }}>
        <div class="container quote-section__inner" data-reveal-target="item">
            <svg class="quote-mark" width="40" height="32" viewBox="0 0 40 32" fill="currentColor" aria-hidden="true">
                <path d="M0 20.8C0 9.3 8 1.7 18.7 0l2 5.6C13.9 7.6 9.9 12 9.6 17.3c1-.5 2.1-.7 3.4-.7 5 0 8.7 3.6 8.7 8.7S17.4 34 12.3 34C5.3 34 0 28.6 0 20.8Zm20.6 0C20.6 9.3 28.6 1.7 39.3 0l2 5.6c-6.8 2-10.8 6.4-11.1 11.7 1-.5 2.1-.7 3.4-.7 5 0 8.7 3.6 8.7 8.7S37.4 34 32.3 34c-7 0-12.3-5.4-12.3-13.2Z" transform="translate(0 -2)"/>
            </svg>
            <p class="quote-section__text">
                “I typed in one city and had a full day planned — attractions, lunch spot, a park to
                decompress in, and a bar for later. It felt like having a local friend who already
                did the research.”
            </p>
            <div class="quote-section__author">
                <span class="avatar" aria-hidden="true">MK</span>
                <div>
                    <strong>Mira K.</strong>
                    <span>Traveled to 14 cities with Tripora</span>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-banner">
        <div class="container cta-banner__inner">
            <h2>Pick a city. We'll handle the rest.</h2>
            <p>It's free to explore — no account required to start browsing.</p>
            <a href="#search" class="btn btn--light">Start exploring now</a>
        </div>
    </section>

{% endblock %}
