{% extends 'base.html.twig' %}

{% block body_class %}page-home{% endblock %}

{% block body %}
    {% set categories = [
        { icon: 'pin', label: 'Sehenswürdigkeiten' },
        { icon: 'fork', label: 'Restaurants' },
        { icon: 'cup', label: 'Cafés' },
        { icon: 'columns', label: 'Museen & Kultur' },
        { icon: 'tree', label: 'Parks & Natur' },
        { icon: 'moon', label: 'Nightlife' },
        { icon: 'spark', label: 'Geheimtipps' },
        { icon: 'route', label: 'Routenplanung' },
    ] %}

    <section class="explore-search" id="suche">
        <div class="container">
            <div class="city-search explore-searchbar" {{ stimulus_controller('city-search', { cities: cities_data, popular: popular_slugs, limit: 8 }) }}>
                <form class="search-bar explore-searchbar__pill" action="{{ path('app_search') }}" method="get" role="search" aria-label="Stadt suchen">
                    <div class="search-bar__slot">
                        <span class="search-bar__label">Wohin?</span>
                        <div class="search-bar__field">
                            <svg class="search-bar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                            <label for="city-input" class="sr-only">Stadt</label>
                            <input
                                type="text"
                                id="city-input"
                                name="city"
                                class="search-bar__input"
                                placeholder="Berlin, Hamburg, München ..."
                                autocomplete="off"
                                required
                                role="combobox"
                                aria-expanded="false"
                                aria-autocomplete="list"
                                aria-haspopup="listbox"
                                aria-controls="city-listbox"
                                data-city-search-target="input"
                                data-action="focus->city-search#onFocus input->city-search#onInput keydown->city-search#onKeydown"
                            >
                        </div>
                    </div>

                    <span class="search-bar__divider" aria-hidden="true"></span>

                    <div class="search-bar__slot search-bar__slot--meta" aria-hidden="true">
                        <span class="search-bar__label">Gerade beliebt</span>
                        <span class="search-bar__value">
                            {% for city in popular_cities|slice(0, 3) %}
                                {{ city.name }}{% if not loop.last %} · {% endif %}
                            {% endfor %}
                        </span>
                    </div>

                    <button type="submit" class="btn explore-searchbar__submit" aria-label="Suchen">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <span class="explore-searchbar__submit-label" aria-hidden="true">Suchen</span>
                    </button>
                </form>
                <div
                    class="city-search__panel"
                    id="city-listbox"
                    role="listbox"
                    aria-label="Stadtvorschläge"
                    data-city-search-target="panel"
                    hidden
                ></div>
            </div>
        </div>
    </section>

    <div class="explore" {{ stimulus_controller('category-filter') }}>
        <nav class="explore-categories" aria-label="Kategorien">
            <div class="container explore-categories__scroll">
                <button type="button" class="explore-cat is-active" data-category-filter-target="tab" data-action="click->category-filter#select" data-category-filter-category-param="all">
                    <span class="explore-cat__icon">{% include 'partials/_icon.html.twig' with { icon: 'spark' } %}</span>
                    <span>Alle</span>
                </button>
                {% for cat in categories %}
                    <button type="button" class="explore-cat" data-category-filter-target="tab" data-action="click->category-filter#select" data-category-filter-category-param="{{ cat.icon }}">
                        <span class="explore-cat__icon">{% include 'partials/_icon.html.twig' with { icon: cat.icon } %}</span>
                        <span>{{ cat.label }}</span>
                    </button>
                {% endfor %}
            </div>
        </nav>

        <div class="explore-main">
            <div class="container">
                <section class="explore-section" id="staedte" data-category-filter-target="section" {{ stimulus_controller('reveal') }}>
                    <div class="section-heading section-heading--tight">
                        <div>
                            <h2>Beliebte Städte</h2>
                            <p class="section-heading__note">
                                Bewertungen und Budgets sind Vorschau-Werte für ein kommendes Feature und noch keine echten Nutzerdaten.
                            </p>
                        </div>
                    </div>
                    <div class="listing-grid">
                        {% for city in popular_cities %}
                            {% include 'partials/_listing_card.html.twig' with { city: city } %}
                        {% endfor %}
                    </div>
                </section>

                <section class="explore-section" id="reiseziele" data-category-filter-target="section" {{ stimulus_controller('reveal') }}>
                    <div class="section-heading section-heading--tight">
                        <div>
                            <h2>Alle Reiseziele in Deutschland</h2>
                        </div>
                    </div>
                    <div class="listing-grid">
                        {% for city in cities %}
                            {% include 'partials/_listing_card.html.twig' with { city: city } %}
                        {% endfor %}
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}
