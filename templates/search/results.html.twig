{% extends 'base.html.twig' %}

{% block title %}Exploring {{ city }} — Tripora{% endblock %}
{% block meta_description %}Tripora is mapping out the best attractions, restaurants and hidden gems in {{ city }}.{% endblock %}
{% block body_class %}page-search{% endblock %}

{% block body %}
    <section class="section holding">
        <div class="container holding__inner">
            <p class="eyebrow">Exploring</p>
            <h1>{{ city }}</h1>
            <p class="holding__text">
                We're still mapping out attractions, restaurants, hidden gems and itineraries for
                <strong>{{ city }}</strong> in detail. Full search results are launching soon —
                thanks for being an early explorer.
            </p>
            <a href="{{ path('app_home') }}" class="btn btn--primary">Back to homepage</a>
        </div>
    </section>
{% endblock %}
