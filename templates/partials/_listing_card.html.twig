{#
    Airbnb-style listing card, repurposed for a German city instead of
    a rentable home: a square "photo" (skyline art standing in for
    real photography, matching partials/_skyline.html.twig elsewhere),
    a save/heart icon, a "Gästefavorit" badge for top-rated cities, and
    a title/meta/price+rating block underneath — mirroring Airbnb's own
    card layout (title line, muted subtitle line, price + rating line).

    Expects a single `city` variable (App\City\GermanCity).
#}
<a
    href="{{ path('app_city', { slug: city.slug }) }}"
    class="listing-card listing-card--{{ city.accent }}"
    data-category="{{ city.highlightIcon }}"
    data-category-filter-target="card"
    data-reveal-target="item"
>
    <span class="listing-card__photo">
        <span class="listing-card__skyline">
            {% include 'partials/_skyline.html.twig' with { lights: true } %}
        </span>
        {% if city.rating >= 4.7 %}
            <span class="listing-card__badge">Gästefavorit</span>
        {% endif %}
        <span class="listing-card__heart" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M12 21s-7.1-4.35-9.33-8.9C1.02 8.28 2.36 4.9 5.7 4.06c2-.5 4 .3 5 2.02 1-1.72 3-2.52 5-2.02 3.34.84 4.68 4.22 3.03 8.04C19.1 16.65 12 21 12 21Z"/>
            </svg>
        </span>
    </span>

    <span class="listing-card__title">{{ city.name }}</span>
    <span class="listing-card__meta">{{ city.state }}</span>
    <span class="listing-card__price">
        <strong>ab {{ city.dailyBudgetFrom }} €</strong> / Tag
        <span class="listing-card__stars">
            <svg viewBox="0 0 24 24"><path d="M12 2l3 7 7 .6-5.3 4.6L18.3 22 12 18l-6.3 4 1.6-7.8L2 9.6 9 9z"/></svg>
            {{ city.ratingLabel() }}
        </span>
    </span>
</a>
