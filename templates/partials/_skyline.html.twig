{#
    Decorative skyline silhouette used as a lightweight, dependency-free
    stand-in for city photography (hero banner + city cards).

    Pass `lights: true` to render a few lit-window accents on top —
    used for the hero's photographic evening-skyline treatment.
#}
{% set lights = lights|default(false) %}
<svg class="skyline-art" viewBox="0 0 200 90" preserveAspectRatio="none" fill="currentColor" aria-hidden="true" focusable="false">
    <rect x="2" y="52" width="16" height="38"/>
    <rect x="20" y="34" width="12" height="56"/>
    <rect x="34" y="58" width="18" height="32"/>
    <rect x="54" y="18" width="14" height="72"/>
    <rect x="70" y="40" width="20" height="50"/>
    <rect x="92" y="10" width="10" height="80"/>
    <rect x="104" y="30" width="16" height="60"/>
    <rect x="122" y="48" width="22" height="42"/>
    <rect x="148" y="22" width="12" height="68"/>
    <rect x="162" y="44" width="18" height="46"/>
    <rect x="182" y="14" width="14" height="76"/>
    {% if lights %}
        <g class="skyline-art__lights" fill="#FFD9A0">
            <rect x="6" y="60" width="3" height="4"/>
            <rect x="24" y="44" width="3" height="4"/>
            <rect x="38" y="68" width="3" height="4"/>
            <rect x="58" y="30" width="3" height="4"/>
            <rect x="76" y="52" width="3" height="4"/>
            <rect x="96" y="24" width="3" height="4"/>
            <rect x="109" y="42" width="3" height="4"/>
            <rect x="128" y="60" width="3" height="4"/>
            <rect x="152" y="34" width="3" height="4"/>
            <rect x="168" y="56" width="3" height="4"/>
            <rect x="186" y="28" width="3" height="4"/>
        </g>
    {% endif %}
</svg>
