<header class="site-header" {{ stimulus_controller('nav') }}>
    <div class="site-header__bar container">
        <div class="site-header__zone--brand">
            <a href="{{ path('app_home') }}" class="brand" aria-label="Tripora — Startseite">
                <span class="brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" width="30" height="30" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 4 C10 4 6 8.5 6 14 C6 20 16 29 16 29 C16 29 26 20 26 14 C26 8.5 22 4 16 4 Z" fill="#FF385C"/>
                        <path d="M11 15.5 L16 10.5 L21 15.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                </span>
                <span class="brand__name">Tripora</span>
            </a>
        </div>

        <div class="site-header__zone--nav">
            <nav class="primary-nav" aria-label="Haupt­navigation">
                <a href="{{ path('app_home') }}#suche">Suchen</a>
                <a href="{{ path('app_home') }}#staedte">Beliebte Städte</a>
                <a href="{{ path('app_home') }}#reiseziele">Alle Reiseziele</a>
            </nav>
        </div>

        <div class="site-header__zone--actions">
            <div class="site-header__actions">
                {% if app.user %}
                    <a class="btn btn--ghost" href="{{ path('app_account') }}" title="Mein Konto">Mein Konto</a>
                    <a class="btn btn--primary site-header__cta" href="{{ path('app_logout') }}">Abmelden</a>
                {% else %}
                    <a class="btn btn--ghost" href="{{ path('app_login') }}">Anmelden</a>
                    <a class="btn btn--primary site-header__cta" href="{{ path('app_register') }}">Registrieren</a>
                {% endif %}
            </div>
        </div>

        <button
            type="button"
            class="nav-toggle"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobile-menu"
            {{ stimulus_action('nav', 'toggle') }}
        >
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
        </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" {{ stimulus_target('nav', 'menu') }} hidden>
        <nav aria-label="Mobile Navigation">
            <a href="{{ path('app_home') }}#suche" {{ stimulus_action('nav', 'close') }}>Suchen</a>
            <a href="{{ path('app_home') }}#staedte" {{ stimulus_action('nav', 'close') }}>Beliebte Städte</a>
            <a href="{{ path('app_home') }}#reiseziele" {{ stimulus_action('nav', 'close') }}>Alle Reiseziele</a>
            {% if app.user %}
                <a href="{{ path('app_account') }}" {{ stimulus_action('nav', 'close') }}>Mein Konto</a>
                <a class="btn btn--primary site-header__cta btn--block" href="{{ path('app_logout') }}" {{ stimulus_action('nav', 'close') }}>Abmelden</a>
            {% else %}
                <a href="{{ path('app_login') }}" {{ stimulus_action('nav', 'close') }}>Anmelden</a>
                <a class="btn btn--primary site-header__cta btn--block" href="{{ path('app_register') }}" {{ stimulus_action('nav', 'close') }}>Registrieren</a>
            {% endif %}
        </nav>
    </div>
</header>
