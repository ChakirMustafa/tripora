<header class="site-header" {{ stimulus_controller('nav') }}>
    <div class="site-header__bar container">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Tripora — Startseite">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 5 L20.5 16 L16 27 L11.5 16 Z" fill="currentColor"/>
                </svg>
            </span>
            <span class="brand__name">Tripora</span>
        </a>

        <nav class="primary-nav" aria-label="Haupt­navigation">
            <a href="#staedte">Städte entdecken</a>
            <a href="#reiseziele">Alle Reiseziele</a>
            <a href="#so-funktionierts">So funktioniert's</a>
            <a href="#kategorien">Was dich erwartet</a>
        </nav>

        <div class="site-header__actions">
            <a class="btn btn--ghost" href="#" data-action="click->nav#comingSoon">Anmelden</a>
            <a class="btn btn--primary" href="#suche">
                <span>Jetzt entdecken</span>
            </a>
        </div>

        <button
            type="button"
            class="nav-toggle"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobile-menu"
            {{ stimulus_action('nav', 'toggle') }}
        >
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
        </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" {{ stimulus_target('nav', 'menu') }} hidden>
        <nav aria-label="Mobile Navigation">
            <a href="#staedte" {{ stimulus_action('nav', 'close') }}>Städte entdecken</a>
            <a href="#reiseziele" {{ stimulus_action('nav', 'close') }}>Alle Reiseziele</a>
            <a href="#so-funktionierts" {{ stimulus_action('nav', 'close') }}>So funktioniert's</a>
            <a href="#kategorien" {{ stimulus_action('nav', 'close') }}>Was dich erwartet</a>
            <a class="btn btn--primary btn--block" href="#suche" {{ stimulus_action('nav', 'close') }}>Jetzt entdecken</a>
        </nav>
    </div>
</header>
