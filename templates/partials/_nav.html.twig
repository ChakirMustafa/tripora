<header class="site-header" {{ stimulus_controller('nav') }}>
    <div class="site-header__bar container">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Tripora — home">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 5 L20.5 16 L16 27 L11.5 16 Z" fill="currentColor"/>
                </svg>
            </span>
            <span class="brand__name">Tripora</span>
        </a>

        <nav class="primary-nav" aria-label="Primary">
            <a href="#explore">Explore cities</a>
            <a href="#how-it-works">How it works</a>
            <a href="#what-you-get">What you'll find</a>
        </nav>

        <div class="site-header__actions">
            <a class="btn btn--ghost" href="#" data-action="click->nav#comingSoon">Sign in</a>
            <a class="btn btn--primary" href="#search">
                <span>Start exploring</span>
            </a>
        </div>

        <button
            type="button"
            class="nav-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            {{ stimulus_action('nav', 'toggle') }}
        >
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
        </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" {{ stimulus_target('nav', 'menu') }} hidden>
        <nav aria-label="Mobile">
            <a href="#explore" {{ stimulus_action('nav', 'close') }}>Explore cities</a>
            <a href="#how-it-works" {{ stimulus_action('nav', 'close') }}>How it works</a>
            <a href="#what-you-get" {{ stimulus_action('nav', 'close') }}>What you'll find</a>
            <a class="btn btn--primary btn--block" href="#search" {{ stimulus_action('nav', 'close') }}>Start exploring</a>
        </nav>
    </div>
</header>
